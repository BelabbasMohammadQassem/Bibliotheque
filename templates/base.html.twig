<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Bibliothèque{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_main') }}">Bibliothèque</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                   
                </ul>
                <div class="navbar-nav">
                    {% if not app.user %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary me-2">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary">Inscription</a>
                {% else %}
                    {% if 'ROLE_ADMIN' in app.user.roles %}
                        <a href="{{ path('app_book_back_index') }}" class="btn btn-primary me-2">Back Office</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-danger">Déconnexion</a>
                {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        {% block body %}{% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>