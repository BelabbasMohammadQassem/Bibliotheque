{% extends 'base.html.twig' %}

{% block title %}Book Index{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="text-center mb-4">Book Index</h1>

    <div class="table-responsive">
        <table class="table table-striped table-bordered text-center">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Title</th>
                    <th scope="col">Publication Year</th>
                    <th scope="col">ISBN</th>
                    <th scope="col">Authors</th>
                    <th scope="col">Categories</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for book in books %}
                    <tr>
                        <td>{{ book.id }}</td>
                        <td>{{ book.title }}</td>
                        <td>{{ book.publicationYear }}</td>
                        <td>{{ book.isbn }}</td>
                        <td>{{ book.authorsString }}</td>
                        <td>{{ book.categoriesString }}</td>
                        <td>
                            <a href="{{ path('app_book_back_show', {'id': book.id}) }}" class="btn btn-sm btn-info">Show</a>
                            <a href="{{ path('app_book_back_edit', {'id': book.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted">No records found</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center mt-4">
        <a href="{{ path('app_book_back_new') }}" class="btn btn-success">Create New Book</a>
    </div>
</div>
{% endblock %}