{% extends 'base.html.twig' %}

{% block title %}Book index{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}

    <h1>Book index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>PublicationYear</th>
                <th>Isbn</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td>{{ book.id }}</td>
                <td>{{ book.title }}</td>
                <td>{{ book.publicationYear }}</td>
                <td>{{ book.isbn }}</td>
                <td>
                    <a href="{{ path('app_book_back_show', {'id': book.id}) }}">show</a>
                    <a href="{{ path('app_book_back_edit', {'id': book.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_book_back_new') }}">Create new</a>
    {% endif %}

{% endblock %}
