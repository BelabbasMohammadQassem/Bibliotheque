{% extends 'base.html.twig' %}

{% block title %}Book{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}

    <h1>Book</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ book.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ book.title }}</td>
            </tr>
            <tr>
                <th>PublicationYear</th>
                <td>{{ book.publicationYear }}</td>
            </tr>
            <tr>
                <th>Isbn</th>
                <td>{{ book.isbn }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_book_back_index') }}">back to list</a>

    <a href="{{ path('app_book_back_edit', {'id': book.id}) }}">edit</a>

    {{ include('book_back/_delete_form.html.twig') }}
    {% endif %}

{% endblock %}
