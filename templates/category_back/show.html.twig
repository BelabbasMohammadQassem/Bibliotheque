{% extends 'base.html.twig' %}

{% block title %}Category{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}

    <h1>Category</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ category.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_category_back_index') }}">back to list</a>

    <a href="{{ path('app_category_back_edit', {'id': category.id}) }}">edit</a>

    {{ include('category_back/_delete_form.html.twig') }}
    {% endif %}

{% endblock %}
