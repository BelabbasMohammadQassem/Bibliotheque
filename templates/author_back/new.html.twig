{% extends 'base.html.twig' %}

{% block title %}New Author{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<div class="container mt-5">
    <h1 class="text-center mb-4">Create New Author</h1>

    <div class="card shadow-lg">
        <div class="card-body">
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.name, 'Name', { 'label_attr': { 'class': 'form-label' } }) }}
                {{ form_widget(form.name, { 'attr': { 'class': 'form-control' } }) }}
            </div>



            <div class="text-center">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> {{ button_label|default('Create') }}
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_author_back_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>
{% endif %}
{% endblock %}
