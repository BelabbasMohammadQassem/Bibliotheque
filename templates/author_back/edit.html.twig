{% extends 'base.html.twig' %}

{% block title %}Edit Author{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<div class="container mt-5">
    <h1 class="text-center mb-4">Edit Author</h1>

    <div class="card shadow-lg">
        <div class="card-body">
            {{ include('author_back/_form.html.twig', {'button_label': 'Update'}) }}
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_author_back_index') }}" class="btn btn-secondary me-2">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
        
        {{ include('author_back/_delete_form.html.twig', {
            'attr': {'class': 'd-inline'}
        }) }}
    </div>
</div>
{% endif %}
{% endblock %}
