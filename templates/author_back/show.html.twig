        </tbody>
    </table>

    <a href="{{ path('app_author_back_index') }}">back to list</a>

    <a href="{{ path('app_author_back_edit', {'id': author.id}) }}">edit</a>

    {{ include('author_back/_delete_form.html.twig') }}
{% endblock %}
