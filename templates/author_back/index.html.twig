{% extends 'base.html.twig' %}

{% block title %}Author Index{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<div class="container mt-5">
    <h1 class="text-center mb-4">Author Index</h1>

    <div class="card shadow-lg">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for author in authors %}
                        <tr>
                            <td>{{ author.id }}</td>
                            <td>{{ author.name }}</td>
                            <td>
                                <a href="{{ path('app_author_back_show', {'id': author.id}) }}" class="btn btn-sm btn-info text-white">
                                    <i class="fas fa-eye"></i> Show
                                </a>
                                <a href="{{ path('app_author_back_edit', {'id': author.id}) }}" class="btn btn-sm btn-warning text-white">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center">No records found</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_author_back_new') }}" class="btn btn-success">
            <i class="fas fa-plus"></i> Create New
        </a>
    </div>
</div>
{% endif %}
{% endblock %}